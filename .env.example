# Shared OpenAI-compatible gateway fallback. For api.gpt.ge, keep the /v1 suffix.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
TIMEOUT_SECONDS=60

# All online LLM/VLM calls share LLM_BASE_URL and LLM_API_KEY; these variables only select models.
VISION_MODEL=qwen3-vl-flash
AUDIO_VISION_MODEL=qwen3-vl-flash
REASONING_MODEL=gpt-5
JUDGE_MODEL=claude-haiku-4-5-20251001
LLM_MODEL=gpt-5

# Fine-grained hybrid pipeline model overrides. Leave blank to use role defaults.
EVENT_OBSERVER_MODEL=qwen3-vl-flash
ANCHOR_EXTRACTOR_MODEL=qwen3-vl-flash
STATE_CONSTRUCTOR_MODEL=gpt-5
QUERY_PLANNER_MODEL=gpt-5
HYPOTHESIS_GENERATOR_MODEL=gpt-5
HYPOTHESIS_GENERATOR_MAX_ATTEMPTS=2
HYPOTHESIS_GENERATOR_FALLBACK_MODEL=
EVIDENCE_BINDER_MODEL=gpt-5
CANDIDATE_EVALUATOR_MODEL=gpt-5
COVERAGE_CHECKER_MODEL=claude-haiku-4-5-20251001
FRAME_RERANKER_MODEL=claude-haiku-4-5-20251001

# Feature toggles
ENABLE_ONLINE_REASONING=true
ENABLE_ONLINE_JUDGE=true
ENABLE_AUDIO_IN_MULTIMODAL=true
MAX_AUDIO_FILES_PER_MULTIMODAL_CALL=1
FINAL_REASONING_MAX_ANCHORS=8
FINAL_REASONING_MAX_EVIDENCES=32
FINAL_REASONING_MAX_BINDINGS=32

# Retrieval
SERPER_API_KEY=
TAVILY_API_KEY=

# Runtime knobs
ASR_BACKEND=whisper
