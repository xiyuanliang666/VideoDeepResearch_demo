# Unified gateway forwarding (single endpoint + single key)
LLM_BASE_URL=
LLM_API_KEY=
TIMEOUT_SECONDS=30

# Default model for fallback (optional)
LLM_MODEL=

# Role-based model routing
REASONING_MODEL=openai/gpt-4.1
JUDGE_MODEL=openai/gpt-4.1-mini
VISION_MODEL=openai/gpt-4.1

# Feature toggles
ENABLE_ONLINE_REASONING=true
ENABLE_ONLINE_JUDGE=true

# Retrieval
TAVILY_API_KEY=

# Runtime knobs
ASR_BACKEND=whisper
